<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Background Gradient -->
    <radialGradient id="bgGlow" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#0f2942" />
      <stop offset="60%" stop-color="#09131e" />
      <stop offset="100%" stop-color="#03060a" />
    </radialGradient>

    <!-- Cyan Neon Glow Filter -->
    <filter id="neonCyan" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Strong Core Glow -->
    <filter id="coreGlow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="8" result="blur2" />
      <feMerge>
        <feMergeNode in="blur2" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>

    <!-- Metallic Armor Gradient -->
    <linearGradient id="armorMetal" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2d3748" />
      <stop offset="40%" stop-color="#1a202c" />
      <stop offset="80%" stop-color="#111827" />
      <stop offset="100%" stop-color="#0b0f17" />
    </linearGradient>

    <!-- Chrome Highlight -->
    <linearGradient id="chromeHighlight" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#e2e8f0" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#64748b" stop-opacity="0.1" />
    </linearGradient>

    <!-- Hair Silver Gradient -->
    <linearGradient id="hairSilver" x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="#f8fafc" />
      <stop offset="35%" stop-color="#cbd5e1" />
      <stop offset="70%" stop-color="#94a3b8" />
      <stop offset="100%" stop-color="#475569" />
    </linearGradient>

    <!-- Face Porcelain Gradient -->
    <linearGradient id="facePorcelain" x1="30%" y1="0%" x2="70%" y2="100%">
      <stop offset="0%" stop-color="#f8fafc" />
      <stop offset="50%" stop-color="#e2e8f0" />
      <stop offset="85%" stop-color="#cbd5e1" />
      <stop offset="100%" stop-color="#94a3b8" />
    </linearGradient>
  </defs>

  <!-- Dark Atmospheric Background -->
  <rect width="512" height="512" fill="url(#bgGlow)" />

  <!-- Cybernetic Hex Grid in Background -->
  <g opacity="0.15" stroke="#06b6d4" stroke-width="1.2" fill="none">
    <polygon points="256,40 286,57 286,92 256,109 226,92 226,57" />
    <polygon points="320,77 350,94 350,129 320,146 290,129 290,94" />
    <polygon points="192,77 222,94 222,129 192,146 162,129 162,94" />
    <polygon points="384,114 414,131 414,166 384,183 354,166 354,131" />
    <polygon points="128,114 158,131 158,166 128,183 98,166 98,131" />
    <line x1="0" y1="256" x2="512" y2="256" stroke-dasharray="8,6" />
    <line x1="256" y1="0" x2="256" y2="512" stroke-dasharray="8,6" />
    <circle cx="256" cy="240" r="190" stroke-dasharray="6,4" />
  </g>

  <!-- Cyan Holographic Backdrop Rim -->
  <path d="M 120 180 Q 256 90 392 180" fill="none" stroke="#22d3ee" stroke-width="2" opacity="0.5" filter="url(#neonCyan)" />

  <!-- Body & Stealth Armor Shoulders -->
  <g id="armor-chassis">
    <!-- Base Neck & Torso Mesh -->
    <path d="M 195 360 L 170 512 L 342 512 L 317 360 Z" fill="#0f172a" />
    <!-- Armor Pauldrons -->
    <path d="M 90 440 L 195 380 L 180 512 L 80 512 Z" fill="url(#armorMetal)" stroke="#334155" stroke-width="1.5" />
    <path d="M 422 440 L 317 380 L 332 512 L 432 512 Z" fill="url(#armorMetal)" stroke="#334155" stroke-width="1.5" />

    <!-- High-Collar Cyber Gorget -->
    <path d="M 188 340 L 210 390 L 302 390 L 324 340 L 295 315 L 217 315 Z" fill="url(#armorMetal)" stroke="#475569" stroke-width="2" />
    <path d="M 210 390 L 256 460 L 302 390 Z" fill="#090d16" stroke="#06b6d4" stroke-width="1.5" />

    <!-- Aether Core Glowing Reactor on Chest -->
    <circle cx="256" cy="425" r="14" fill="#06b6d4" filter="url(#coreGlow)" />
    <circle cx="256" cy="425" r="8" fill="#ffffff" />
    <polygon points="256,405 272,425 256,445 240,425" fill="none" stroke="#22d3ee" stroke-width="1.8" filter="url(#neonCyan)" />

    <!-- Cybernetic Energy Conduit Lines -->
    <path d="M 195 380 L 240 425 M 317 380 L 272 425" stroke="#06b6d4" stroke-width="2.5" opacity="0.8" filter="url(#neonCyan)" />
    <path d="M 130 450 L 180 430 L 230 480" stroke="#06b6d4" stroke-width="1.5" opacity="0.6" />
    <path d="M 382 450 L 332 430 L 282 480" stroke="#06b6d4" stroke-width="1.5" opacity="0.6" />
  </g>

  <!-- Neck -->
  <path d="M 226 280 L 226 335 L 286 335 L 286 280 Z" fill="url(#facePorcelain)" />
  <!-- Cyber Seams on Neck -->
  <line x1="240" y1="290" x2="240" y2="330" stroke="#06b6d4" stroke-width="1.5" opacity="0.8" filter="url(#neonCyan)" />
  <line x1="272" y1="290" x2="272" y2="330" stroke="#06b6d4" stroke-width="1.5" opacity="0.8" filter="url(#neonCyan)" />

  <!-- Head & Facial Structure -->
  <g id="head">
    <!-- Jaw and Face Oval -->
    <path d="M 188 180 C 185 245 200 295 256 320 C 312 295 327 245 324 180 C 324 130 300 110 256 110 C 212 110 188 130 188 180 Z"
          fill="url(#facePorcelain)" stroke="#94a3b8" stroke-width="1.5" />

    <!-- Delicate Android Seam Lines on Cheeks -->
    <path d="M 205 235 C 210 255 220 270 236 280" fill="none" stroke="#67e8f9" stroke-width="1.2" opacity="0.75" filter="url(#neonCyan)" />
    <path d="M 307 235 C 302 255 292 270 276 280" fill="none" stroke="#67e8f9" stroke-width="1.2" opacity="0.75" filter="url(#neonCyan)" />

    <!-- Nose Structure -->
    <path d="M 256 200 L 253 245 L 259 245 Z" fill="#94a3b8" opacity="0.6" />
    <path d="M 251 247 Q 256 250 261 247" fill="none" stroke="#64748b" stroke-width="1.5" />

    <!-- Lips (Subtle Cyber Crimson/Rose) -->
    <path d="M 242 272 Q 256 268 270 272 Q 256 277 242 272 Z" fill="#e11d48" opacity="0.85" />
    <path d="M 245 273 Q 256 283 267 273" fill="none" stroke="#be123c" stroke-width="1.2" />

    <!-- Piercing Cybernetic Android Eyes -->
    <!-- Left Eye -->
    <g transform="translate(0, 0)">
      <path d="M 215 205 Q 230 196 244 205 Q 230 214 215 205 Z" fill="#0f172a" stroke="#334155" stroke-width="1.5" />
      <circle cx="229" cy="205" r="5" fill="#06b6d4" filter="url(#coreGlow)" />
      <circle cx="229" cy="205" r="2.5" fill="#ffffff" />
      <!-- Holographic Reticle Ring -->
      <circle cx="229" cy="205" r="7.5" fill="none" stroke="#22d3ee" stroke-width="0.8" stroke-dasharray="3,2" opacity="0.9" />
    </g>

    <!-- Right Eye -->
    <g transform="translate(0, 0)">
      <path d="M 268 205 Q 282 196 297 205 Q 282 214 268 205 Z" fill="#0f172a" stroke="#334155" stroke-width="1.5" />
      <circle cx="283" cy="205" r="5" fill="#06b6d4" filter="url(#coreGlow)" />
      <circle cx="283" cy="205" r="2.5" fill="#ffffff" />
      <!-- Holographic Reticle Ring -->
      <circle cx="283" cy="205" r="7.5" fill="none" stroke="#22d3ee" stroke-width="0.8" stroke-dasharray="3,2" opacity="0.9" />
    </g>

    <!-- Eyebrows (Sharp, Precise) -->
    <path d="M 214 195 Q 230 188 244 193" fill="none" stroke="#334155" stroke-width="2.5" stroke-linecap="round" />
    <path d="M 298 195 Q 282 188 268 193" fill="none" stroke="#334155" stroke-width="2.5" stroke-linecap="round" />
  </g>

  <!-- Sleek Hair (Asymmetric Platinum-Silver Bob with Glowing Cyan Highlights) -->
  <g id="hair">
    <!-- Back Hair Silhouette -->
    <path d="M 170 160 C 150 230 155 310 185 340 C 180 290 185 220 190 180 Z" fill="#334155" />
    <path d="M 342 160 C 362 230 357 310 327 340 C 332 290 327 220 322 180 Z" fill="#334155" />

    <!-- Main Hair Volume -->
    <path d="M 180 160 C 180 85 240 70 270 70 C 330 70 345 110 340 180 C 330 170 310 150 295 155 C 275 160 260 175 250 190 C 240 170 215 155 180 160 Z"
          fill="url(#hairSilver)" stroke="#475569" stroke-width="1.5" />

    <!-- Left Angular Bang Lock -->
    <path d="M 195 140 C 175 190 165 260 175 320 C 180 270 190 220 205 175 Z"
          fill="url(#hairSilver)" stroke="#64748b" stroke-width="1.2" />

    <!-- Glowing Cyan/Teal Underlight Streak -->
    <path d="M 180 220 C 170 265 175 305 180 325" fill="none" stroke="#06b6d4" stroke-width="3" filter="url(#neonCyan)" />

    <!-- Right Angular Swept Bang -->
    <path d="M 270 75 C 315 110 340 170 345 270 C 335 220 320 180 295 165 Z"
          fill="url(#hairSilver)" stroke="#64748b" stroke-width="1.2" />
    <path d="M 335 200 C 342 235 343 270 340 285" fill="none" stroke="#06b6d4" stroke-width="2.5" filter="url(#neonCyan)" />

    <!-- Crown Bang Strands -->
    <path d="M 235 110 C 220 145 205 180 195 210" fill="none" stroke="#f1f5f9" stroke-width="1.8" />
    <path d="M 270 100 C 285 130 300 160 310 195" fill="none" stroke="#f1f5f9" stroke-width="1.8" />
    <path d="M 252 80 C 255 120 252 160 248 185" fill="none" stroke="#cbd5e1" stroke-width="1.5" />
  </g>

  <!-- HUD Telemetry & Tech Overlays -->
  <g id="hud-elements" opacity="0.85">
    <!-- Top Left Code -->
    <text x="32" y="44" font-family="monospace" font-size="12" font-weight="bold" fill="#06b6d4" letter-spacing="1">UNIT-0 // VALERIA</text>
    <text x="32" y="60" font-family="monospace" font-size="9" fill="#94a3b8">HEGEMONY COMBAT ANDROID</text>

    <!-- Top Right Status -->
    <text x="480" y="44" text-anchor="end" font-family="monospace" font-size="11" font-weight="bold" fill="#22d3ee" letter-spacing="1">SYS: OVERRIDE</text>
    <text x="480" y="60" text-anchor="end" font-family="monospace" font-size="9" fill="#ef4444">PURGE PROTOCOL</text>

    <!-- Bottom Left Target Data -->
    <text x="32" y="475" font-family="monospace" font-size="10" fill="#67e8f9">ATK: 185 // SPD: 125</text>
    <text x="32" y="492" font-family="monospace" font-size="9" fill="#64748b">AETHER PLASMA BLADES: ARMED</text>

    <!-- Target Reticle Box around eye -->
    <rect x="210" y="190" width="38" height="30" fill="none" stroke="#06b6d4" stroke-width="1" stroke-dasharray="4,2" opacity="0.6" />
    <line x1="210" y1="185" x2="210" y2="195" stroke="#22d3ee" stroke-width="2" />
    <line x1="248" y1="185" x2="248" y2="195" stroke="#22d3ee" stroke-width="2" />
    <line x1="210" y1="215" x2="210" y2="225" stroke="#22d3ee" stroke-width="2" />
    <line x1="248" y1="215" x2="248" y2="225" stroke="#22d3ee" stroke-width="2" />

    <!-- Corner Brackets -->
    <path d="M 20 50 L 20 20 L 50 20" fill="none" stroke="#06b6d4" stroke-width="2.5" />
    <path d="M 492 50 L 492 20 L 462 20" fill="none" stroke="#06b6d4" stroke-width="2.5" />
    <path d="M 20 462 L 20 492 L 50 492" fill="none" stroke="#06b6d4" stroke-width="2.5" />
    <path d="M 492 462 L 492 492 L 462 492" fill="none" stroke="#06b6d4" stroke-width="2.5" />
  </g>
</svg>
